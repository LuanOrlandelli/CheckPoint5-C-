<Window x:Class="CadastroProdutos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Produtos"
        Height="720"
        Width="1100"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#374151" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1F2937">
            <StackPanel Margin="18,28">
                <TextBlock Text="PRODUTOS"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="8,0,0,30" />

                <Button Content="1. Inserir produto" Click="BtnInserir_Click" Style="{StaticResource MenuButtonStyle}" />
                <Button Content="2. Listar produtos" Click="BtnListar_Click" Style="{StaticResource MenuButtonStyle}" />
                <Button Content="3. Buscar por ID" Click="BtnBuscar_Click" Style="{StaticResource MenuButtonStyle}" />
                <Button Content="4. Atualizar produto" Click="BtnAtualizar_Click" Style="{StaticResource MenuButtonStyle}" />
                <Button Content="5. Excluir produto" Click="BtnExcluir_Click" Style="{StaticResource MenuButtonStyle}" />
                <Button Content="6. Sair" Click="BtnSair_Click" Style="{StaticResource MenuButtonStyle}" Margin="0,22,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Gerenciamento de Produtos" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock Text="WPF + C# + ADO.NET + SQL Server LocalDB" Foreground="#6B7280" FontSize="14" Margin="0,6,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="ID" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtId" Grid.Row="0" Grid.Column="1" Margin="5" Height="32" Padding="8,5" />

                    <TextBlock Text="Nome" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="15,0,0,0" />
                    <TextBox x:Name="TxtNome" Grid.Row="0" Grid.Column="3" Margin="5" Height="32" Padding="8,5" />

                    <TextBlock Text="Preço" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtPreco" Grid.Row="1" Grid.Column="1" Margin="5" Height="32" Padding="8,5" />

                    <TextBlock Text="Estoque" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="15,0,0,0" />
                    <TextBox x:Name="TxtEstoque" Grid.Row="1" Grid.Column="3" Margin="5" Height="32" Padding="8,5" />

                    <TextBlock Text="Categoria" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtCategoria" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="5" Height="32" Padding="8,5" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12">
                <DataGrid x:Name="DgProdutos"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionChanged="DgProdutos_SelectionChanged"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                        <DataGridTextColumn Header="Preço" Binding="{Binding Preco, StringFormat=C}" Width="130" />
                        <DataGridTextColumn Header="Estoque" Binding="{Binding Estoque}" Width="110" />
                        <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>


</Window>
